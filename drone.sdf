<sdf version="1.6">
  <model name="quadrotor">
    <pose>0 0 1 0 0 0</pose>

    <link name="base_link">
	<plugin
	  filename="gz-sim-velocity-control-system"
 	 name="gz::sim::systems::VelocityControl">
</plugin>
      <inertial>
        <mass>1.5</mass>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.4 0.4 0.1</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.4 0.4 0.1</size>
          </box>
        </geometry>
      </visual>

    </link>

  </model>
</sdf>
